{
  "name": "nightink-app",
  "version": "1.2.1",
  "private": true,
  "scripts": {
    "check": "node --check src/index.js && node --check public/auto-tags.js && node --check public/theme.js && node --check backup-nightink.mjs",
    "deploy": "wrangler deploy",
    "backup": "node backup-nightink.mjs",
    "backup:full": "node backup-nightink.mjs --full-media",
    "dry-run": "wrangler deploy --dry-run --outdir dist",
    "db:migrate:local": "wrangler d1 migrations apply nightink-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply nightink-db --remote"
  },
  "devDependencies": {
    "wrangler": "4.127.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
